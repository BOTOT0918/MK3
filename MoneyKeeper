package com.example.moneykeeper

import android.annotation.SuppressLint
import android.app.DatePickerDialog
import android.os.Bundle
import android.view.LayoutInflater
import android.widget.ArrayAdapter
import android.widget.Toast
import androidx.appcompat.app.AlertDialog
import androidx.appcompat.app.AppCompatActivity
import androidx.recyclerview.widget.LinearLayoutManager
import com.example.moneykeeper.data.Record
import com.example.moneykeeper.data.RecordDbHelper
import com.example.moneykeeper.databinding.ActivityMainBinding
import com.example.moneykeeper.databinding.DialogAddBinding
import java.text.DecimalFormat
import java.util.Calendar

class MainActivity : AppCompatActivity() {

    companion object {
        const val TYPE_EXPENSE = 0
        const val TYPE_INCOME = 1
        val EXPENSE_CATS = listOf("餐饮", "交通", "购物")
        val INCOME_CATS = listOf("生活费", "其他")
    }

    private lateinit var binding: ActivityMainBinding
    private lateinit var db: RecordDbHelper
    private lateinit var adapter: RecordAdapter
    private val fmt = DecimalFormat("0.00")

    private var calendar = Calendar.getInstance()
    private var pickedDate: String = ""

    private val currentMonth: String
        get() = "%04d-%02d".format(calendar.get(Calendar.YEAR), calendar.get(Calendar.MONTH) + 1)

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        binding = ActivityMainBinding.inflate(layoutInflater)
        setContentView(binding.root)
        setSupportActionBar(binding.toolbar)

        db = RecordDbHelper(this)
        adapter = RecordAdapter(emptyList()) { record -> confirmDelete(record) }

        binding.recyclerView.layoutManager = LinearLayoutManager(this)
        binding.recyclerView.adapter = adapter

        binding.btnAdd.setOnClickListener { showAddDialog() }
        binding.btnPrev.setOnClickListener { shiftMonth(-1) }
        binding.btnNext.setOnClickListener { shiftMonth(1) }

        pickedDate = today()
        refresh()
    }

    private fun shiftMonth(delta: Int) {
        calendar.add(Calendar.MONTH, delta)
        refresh()
    }

    private fun refresh() {
        binding.tvMonth.text = currentMonth
        val (income, expense) = db.monthSummary(currentMonth)
        binding.tvIncome.text = "本月收入：¥${fmt.format(income)}"
        binding.tvExpense.text = "本月支出：¥${fmt.format(expense)}"
        binding.tvBalance.text = "本月结余：¥${fmt.format(income - expense)}"
        adapter.update(db.queryByMonth(currentMonth))
    }

    @SuppressLint("SetTextI18n")
    private fun showAddDialog() {
        val dialogBinding = DialogAddBinding.inflate(LayoutInflater.from(this))

        // 分类随类型联动
        val catAdapter = ArrayAdapter(this, android.R.layout.simple_spinner_item, EXPENSE_CATS)
        catAdapter.setDropDownViewResource(android.R.layout.simple_spinner_dropdown_item)
        dialogBinding.spCategory.adapter = catAdapter

        dialogBinding.rgType.setOnCheckedChangeListener { _, checkedId ->
            val cats = if (checkedId == dialogBinding.rbIncome.id) INCOME_CATS else EXPENSE_CATS
            val a = ArrayAdapter(this, android.R.layout.simple_spinner_item, cats)
            a.setDropDownViewResource(android.R.layout.simple_spinner_dropdown_item)
            dialogBinding.spCategory.adapter = a
        }

        pickedDate = today()
        dialogBinding.btnDate.text = pickedDate
        dialogBinding.btnDate.setOnClickListener {
            val cal = Calendar.getInstance()
            DatePickerDialog(
                this,
                { _, y, m, d ->
                    pickedDate = "%04d-%02d-%02d".format(y, m + 1, d)
                    dialogBinding.btnDate.text = pickedDate
                },
                cal.get(Calendar.YEAR), cal.get(Calendar.MONTH), cal.get(Calendar.DAY_OF_MONTH)
            ).show()
        }

        AlertDialog.Builder(this)
            .setTitle("记一笔")
            .setView(dialogBinding.root)
            .setPositiveButton("保存") { _, _ ->
                val type = if (dialogBinding.rgType.checkedRadioButtonId == dialogBinding.rbIncome.id)
                    TYPE_INCOME else TYPE_EXPENSE
                val category = dialogBinding.spCategory.selectedItem.toString()
                val amountText = dialogBinding.etAmount.text.toString()
                val amount = amountText.toDoubleOrNull()
                if (amount == null || amount <= 0) {
                    Toast.makeText(this, "请输入有效金额", Toast.LENGTH_SHORT).show()
                    return@setPositiveButton
                }
                val record = Record(
                    type = type,
                    category = category,
                    amount = amount,
                    note = dialogBinding.etNote.text.toString().trim(),
                    date = pickedDate
                )
                db.insert(record)
                // 记账后自动切换到该记录所在月份
                calendar.set(
                    pickedDate.substring(0, 4).toInt(),
                    pickedDate.substring(5, 7).toInt() - 1,
                    1
                )
                refresh()
                Toast.makeText(this, "已保存", Toast.LENGTH_SHORT).show()
            }
            .setNegativeButton("取消", null)
            .show()
    }

    private fun confirmDelete(record: Record) {
        AlertDialog.Builder(this)
            .setTitle("删除记录")
            .setMessage("确定删除这条「${record.category} ¥${fmt.format(record.amount)}」的记录吗？")
            .setPositiveButton("删除") { _, _ ->
                db.delete(record.id)
                refresh()
            }
            .setNegativeButton("取消", null)
            .show()
    }

    private fun today(): String {
        val cal = Calendar.getInstance()
        return "%04d-%02d-%02d".format(
            cal.get(Calendar.YEAR), cal.get(Calendar.MONTH) + 1, cal.get(Calendar.DAY_OF_MONTH)
        )
    }
}


package com.example.moneykeeper

import android.annotation.SuppressLint
import android.graphics.Color
import android.view.LayoutInflater
