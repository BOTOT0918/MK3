import com.example.moneykeeper.data.Record
import com.example.moneykeeper.databinding.ItemRecordBinding
import java.text.DecimalFormat

class RecordAdapter(
    private var records: List<Record>,
    private val onLongClick: (Record) -> Unit
) : RecyclerView.Adapter<RecordAdapter.VH>() {

    private val fmt = DecimalFormat("0.00")

    inner class VH(val binding: ItemRecordBinding) : RecyclerView.ViewHolder(binding.root)

    override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): VH =
        VH(ItemRecordBinding.inflate(LayoutInflater.from(parent.context), parent, false))

    override fun getItemCount(): Int = records.size

    @SuppressLint("SetTextI18n")
    override fun onBindViewHolder(holder: VH, position: Int) {
        val r = records[position]
        with(holder.binding) {
            tvCategory.text = r.category
            tvDate.text = r.date
            tvNote.text = if (r.note.isBlank()) "" else r.note
            if (r.type == 1) {
                tvAmount.text = "+${fmt.format(r.amount)}"
                tvAmount.setTextColor(Color.parseColor("#4CAF50"))
            } else {
                tvAmount.text = "-${fmt.format(r.amount)}"
                tvAmount.setTextColor(Color.parseColor("#F44336"))
            }
            root.setOnLongClickListener {
                onLongClick(r)
                true
            }
        }
    }

    fun update(newList: List<Record>) {
        records = newList
        notifyDataSetChanged()
    }
}

package com.example.moneykeeper.data

data class Record(
    val id: Long = 0,
    val type: Int,        // 0 = 支出, 1 = 收入
    val category: String, // 支出: 餐饮/交通/购物  收入: 生活费/其他
    val amount: Double,
    val note: String,
    val date: String      // yyyy-MM-dd
)


package com.example.moneykeeper.data

import android.content.ContentValues
import android.content.Context
import android.database.sqlite.SQLiteDatabase
import android.database.sqlite.SQLiteOpenHelper

class RecordDbHelper(context: Context) :
    SQLiteOpenHelper(context, DB_NAME, null, DB_VERSION) {

    companion object {
        const val DB_NAME = "money_keeper.db"
        const val DB_VERSION = 1
        const val TABLE = "records"
        const val COL_ID = "id"
        const val COL_TYPE = "type"
        const val COL_CATEGORY = "category"
        const val COL_AMOUNT = "amount"
        const val COL_NOTE = "note"
        const val COL_DATE = "date"
    }

    override fun onCreate(db: SQLiteDatabase) {
        db.execSQL(
            "CREATE TABLE $TABLE (" +
                "$COL_ID INTEGER PRIMARY KEY AUTOINCREMENT," +
                "$COL_TYPE INTEGER NOT NULL," +
                "$COL_CATEGORY TEXT NOT NULL," +
                "$COL_AMOUNT REAL NOT NULL," +
                "$COL_NOTE TEXT," +
                "$COL_DATE TEXT NOT NULL)"
        )
    }

    override fun onUpgrade(db: SQLiteDatabase, oldVersion: Int, newVersion: Int) {
        db.execSQL("DROP TABLE IF EXISTS $TABLE")
        onCreate(db)
    }

    fun insert(record: Record): Long {
        val values = ContentValues().apply {
            put(COL_TYPE, record.type)
            put(COL_CATEGORY, record.category)
            put(COL_AMOUNT, record.amount)
            put(COL_NOTE, record.note)
            put(COL_DATE, record.date)
        }
        return writableDatabase.insert(TABLE, null, values)
    }

    fun delete(id: Long): Int =
        writableDatabase.delete(TABLE, "$COL_ID=?", arrayOf(id.toString()))

    /** 查询某个月(yyyy-MM)的所有记录，按日期倒序 */
    fun queryByMonth(month: String): List<Record> {
        val list = mutableListOf<Record>()
        readableDatabase.query(
            TABLE, null,
            "$COL_DATE LIKE ?",
            arrayOf("$month%"),
            null, null,
            "$COL_DATE DESC, $COL_ID DESC"
        ).use { c ->
            while (c.moveToNext()) {
                list.add(
                    Record(
                        id = c.getLong(c.getColumnIndexOrThrow(COL_ID)),
                        type = c.getInt(c.getColumnIndexOrThrow(COL_TYPE)),
                        category = c.getString(c.getColumnIndexOrThrow(COL_CATEGORY)),
                        amount = c.getDouble(c.getColumnIndexOrThrow(COL_AMOUNT)),
                        note = c.getString(c.getColumnIndexOrThrow(COL_NOTE)) ?: "",
                        date = c.getString(c.getColumnIndexOrThrow(COL_DATE))
                    )
                )
            }
        }
        return list
    }

    /** 统计某月的总收入/总支出 */
    fun monthSummary(month: String): Pair<Double, Double> {
        var income = 0.0
        var expense = 0.0
        readableDatabase.rawQuery(
            "SELECT $COL_TYPE, SUM($COL_AMOUNT) FROM $TABLE WHERE $COL_DATE LIKE ? GROUP BY $COL_TYPE",
            arrayOf("$month%")
        ).use { c ->
            while (c.moveToNext()) {
                if (c.getInt(0) == 1) income = c.getDouble(1) else expense = c.getDouble(1)
            }
        }
        return income to expense
    }
}

